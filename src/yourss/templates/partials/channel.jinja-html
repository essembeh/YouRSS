<section class="yourss-hero" data-channel-page="{{ channel.channel_id }}">
  <img referrerpolicy="no-referrer" src="{{ channel.avatar }}" alt="" class="yourss-avatar yourss-hero-avatar" />
  <div class="yourss-hero-info">
    <h1>{{ channel.name }}{% if channel.handle %} <span class="yourss-hero-handle">{{ channel.handle }}</span>{% endif %}</h1>
    <div class="yourss-hero-actions">
      <a class="yourss-btn yt" href="{{ channel.home }}" target="_blank" rel="noopener"><svg><use href="#i-youtube" /></svg><span>YouTube</span></a>
      <a class="yourss-btn rss" href="/proxy/rss/{{ channel.channel_id }}" target="_blank"><svg><use href="#i-rss" /></svg><span>RSS</span></a>
      <button type="button" class="yourss-btn" data-watched-feature data-action="mark-channel-watched" data-channel-id="{{ channel.channel_id }}" title="Mark the videos of this channel as watched"><svg><use href="#i-check-all" /></svg><span>Mark all watched</span></button>
    </div>
  </div>
</section>

<div class="yourss-tabs-bar">
  <div class="yourss-tabs" role="tablist">
    <button type="button" class="yourss-tab active" role="tab" data-action="tab" hx-get="/htmx/rss/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content">Recent</button>
    {% if tabs is not defined or "videos" in tabs %}
    <button type="button" class="yourss-tab" role="tab" data-action="tab" hx-get="/htmx/videos/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content">Videos</button>
    {% endif %}
    {% if tabs is not defined or "shorts" in tabs %}
    <button type="button" class="yourss-tab" role="tab" data-action="tab" hx-get="/htmx/shorts/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content">Shorts</button>
    {% endif %}
    {% if tabs is not defined or "streams" in tabs %}
    <button type="button" class="yourss-tab" role="tab" data-action="tab" hx-get="/htmx/streams/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content">Streams</button>
    {% endif %}
  </div>
</div>

<div id="tab-content" class="yourss-tab-content" hx-get="/htmx/rss/{{ channel.channel_id }}" hx-trigger="load" hx-indicator="#tab-content"></div>
