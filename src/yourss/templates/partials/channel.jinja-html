{% include "partials/channel-hero.jinja-html" %}

<div class="yourss-tabs-bar">
  <div class="yourss-tabs" role="tablist">
    <button type="button" class="yourss-tab{% if open_tab != 'playlists' %} active{% endif %}" role="tab" data-action="tab" hx-get="/htmx/rss/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">Recent</button>
    {% if tabs is not defined or "videos" in tabs %}
    <button type="button" class="yourss-tab" role="tab" data-action="tab" hx-get="/htmx/videos/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">Videos</button>
    {% endif %}
    {% if tabs is not defined or "shorts" in tabs %}
    <button type="button" class="yourss-tab" role="tab" data-action="tab" hx-get="/htmx/shorts/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">Shorts</button>
    {% endif %}
    {% if tabs is not defined or "streams" in tabs %}
    <button type="button" class="yourss-tab" role="tab" data-action="tab" hx-get="/htmx/streams/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">Streams</button>
    {% endif %}
    {# Playlists, not videos: chosen in the listen sheet, it lists them to pick one (listen-mode.md) #}
    {% if tabs is defined and "playlists" in tabs %}
    <button type="button" class="yourss-tab{% if open_tab == 'playlists' %} active{% endif %}" role="tab" data-action="tab" hx-get="/htmx/playlists/{{ channel.channel_id }}" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">Playlists</button>
    {% endif %}
  </div>
</div>

{# Back from one of its playlists, the channel opens on its Playlists tab #}
{% set opened = "/htmx/playlists/" if open_tab == "playlists" else "/htmx/rss/" %}
<div id="tab-content" class="yourss-tab-content" hx-get="{{ opened }}{{ channel.channel_id }}" hx-trigger="load" hx-indicator="#tab-content" hx-sync="#tab-content:replace"></div>
