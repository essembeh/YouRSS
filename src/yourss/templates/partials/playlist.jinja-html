<section class="yourss-hero" data-channel-page="{{ playlist.playlist_id }}">
  <span class="yourss-avatar yourss-avatar-none yourss-hero-avatar" aria-hidden="true"><svg><use href="#i-list" /></svg></span>
  <div class="yourss-hero-info">
    <h1>{{ playlist.title }} <span class="yourss-hero-handle">playlist by {{ playlist.author.name }}</span></h1>
    <div class="yourss-hero-actions">
      <a class="yourss-btn yt" href="https://www.youtube.com/playlist?list={{ playlist.playlist_id }}" target="_blank" rel="noopener"><svg><use href="#i-youtube" /></svg><span>YouTube</span></a>
      <a class="yourss-btn rss" href="https://www.youtube.com/feeds/videos.xml?playlist_id={{ playlist.playlist_id }}" target="_blank" rel="noopener"><svg><use href="#i-rss" /></svg><span>RSS</span></a>
    </div>
  </div>
</section>

<div class="yourss-tabs-bar">
  <div class="yourss-tabs" role="tablist">
    <button type="button" class="yourss-tab active" role="tab" data-action="tab" title="The latest videos, from the RSS feed" hx-get="/htmx/playlist/{{ playlist.playlist_id }}/recent" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">Recent</button>
    <button type="button" class="yourss-tab" role="tab" data-action="tab" title="Every video of the playlist, in its order" hx-get="/htmx/playlist/{{ playlist.playlist_id }}/all" hx-target="#tab-content" hx-indicator="#tab-content" hx-sync="#tab-content:replace">All</button>
  </div>
</div>

{# Recent is open: the feed was already fetched for the title of the playlist #}
<div id="tab-content" class="yourss-tab-content">
  {% include "partials/videos-container.jinja-html" %}
</div>
