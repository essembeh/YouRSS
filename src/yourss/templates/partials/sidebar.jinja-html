{% from "partials/macros.jinja-html" import avatar, state_marker %}
<aside id="yourss-sidebar" class="yourss-sidebar" aria-label="Navigation">
  <div class="yourss-sidebar-head">
    <a class="yourss-brand" href="{{ home_path|default(request.url.path) }}" title="Reload this page"><img src="{{ static_url('icons/icon-192.png') }}" width="28" height="28" alt="" /><span>You<em>RSS</em></span></a>
    <button type="button" class="yourss-icon-btn yourss-rail-toggle" data-action="rail" title="Collapse / expand sidebar"><svg><use href="#i-chevron" /></svg></button>
  </div>

  <label class="yourss-search" title="Filter the videos on this page (shortcut: /)">
    <svg><use href="#i-search" /></svg>
    <input id="yourss-search" type="search" placeholder="Filter videos" autocomplete="off" />
    <button type="button" class="yourss-icon-btn is-small yourss-search-clear" data-action="clear-search" title="Clear the filter (Esc)" aria-label="Clear the filter" hidden><svg><use href="#i-close" /></svg></button>
  </label>

  <div class="yourss-segment yourss-filter" data-watched-feature role="group" aria-label="Videos shown">
    <button type="button" data-action="set-flag" data-flag="hide-watched" data-value="0" title="Show every video (h)">All</button>
    <button type="button" data-action="set-flag" data-flag="hide-watched" data-value="1" title="Only show the videos not watched yet (h)">New</button>
  </div>

  <nav class="yourss-nav">
    {% if entries %}
    <div class="yourss-row">
      <a class="yourss-nav-item yourss-home-link" href="{{ request.url.path }}" title="The latest videos of all your channels">
        <svg><use href="#i-home" /></svg><span class="yourss-label">Home</span>
        <span class="yourss-badge yourss-count" data-watched-feature data-channel-id="*" hidden></span>
      </a>
      <button type="button" class="yourss-icon-btn is-small yourss-row-btn" data-watched-feature data-action="mark-feed-watched" title="Mark every video as watched"><svg><use href="#i-check-all" /></svg></button>
    </div>
    <div class="yourss-section">
      <span class="yourss-label">Subscriptions</span>
      {% if page_names is defined %}
      <button type="button" class="yourss-icon-btn is-small yourss-row-btn" data-action="add-channel" title="Add a channel or a playlist to this page (a)" aria-label="Add a channel or a playlist"><svg><use href="#i-plus" /></svg></button>
      {% elif copy_url is defined %}
      <a class="yourss-icon-btn is-small yourss-row-btn yourss-copy-page" href="{{ copy_url }}" title="This page is read-only: customize a copy of it" aria-label="Customize a copy of this page"><svg><use href="#i-edit" /></svg></a>
      {% endif %}
    </div>
    <ul class="yourss-channels">
      {% for entry in entries %}
      {% set label = entry.label or entry.name %}
      {% if entry.kind == "playlist" %}
      <li class="yourss-playlist{% if entry.failed %} is-failed{% endif %}" data-playlist-id="{{ entry.id }}">
        <a class="yourss-nav-item" href="{{ request.url.path }}?p={{ entry.id }}" hx-get="/htmx/playlist/{{ entry.id }}" hx-target="#yourss-content" hx-sync="#yourss-content:replace"
          hx-push-url="{{ request.url.path }}?p={{ entry.id }}" title="Playlist: {{ label }}">
          <svg><use href="#i-list" /></svg>
          <span class="yourss-label">{{ label }}</span>
          {{ state_marker(entry) }}
        </a>
      {% else %}
      <li class="yourss-channel{% if entry.failed %} is-failed{% endif %}" data-channel-id="{{ entry.id }}">
        <a class="yourss-nav-item" href="{{ request.url.path }}?c={{ entry.id }}" hx-get="/htmx/channel/{{ entry.id }}" hx-target="#yourss-content" hx-sync="#yourss-content:replace"
          hx-push-url="{{ request.url.path }}?c={{ entry.id }}" title="{{ label }}">
          {% if entry.channel %}{{ avatar(entry.channel, 28) }}{% else %}<span class="yourss-avatar yourss-avatar-none" aria-hidden="true">{{ entry.initial }}</span>{% endif %}
          <span class="yourss-label">{{ label }}</span>
          {{ state_marker(entry) }}
          <span class="yourss-badge yourss-count" data-watched-feature data-channel-id="{{ entry.id }}" hidden></span>
        </a>
      {% endif %}
        {% if page_names is defined %}
        <button type="button" class="yourss-icon-btn is-small yourss-row-btn yourss-remove-btn" data-action="remove-channel" data-id="{{ entry.name }}" data-name="{{ label }}" title="Remove {{ label }} from this page" aria-label="Remove {{ label }}"><svg><use href="#i-close" /></svg></button>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </nav>

  <div class="yourss-sidebar-foot">
    <button type="button" class="yourss-nav-item yourss-settings-btn" data-action="settings" title="Settings">
      <svg><use href="#i-settings" /></svg><span class="yourss-label">Settings</span>
    </button>
    {% include "partials/footer.jinja-html" %}
  </div>
</aside>
