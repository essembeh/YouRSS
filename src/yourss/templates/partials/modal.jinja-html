<dialog id="yourss-modal" class="yourss-modal">
  <div class="yourss-modal-box">
    <div class="yourss-modal-head">
      <span id="yourss-modal-video-title"></span>
      <button type="button" class="yourss-icon-btn" data-action="close-dialog" aria-label="Close"><svg><use href="#i-close" /></svg></button>
    </div>
    <div id="yourss-modal-player" class="yourss-modal-player"></div>
    <div class="yourss-modal-foot">
      <a id="yourss-modal-link-rss" class="yourss-btn rss" target="_blank" rel="noopener" title="Channel RSS feed"><svg><use href="#i-rss" /></svg><span>RSS</span></a>
      <span class="yourss-spacer"></span>
      <a id="yourss-modal-link-youtube" class="yourss-btn yt" data-action="close-dialog" target="_blank" rel="noopener" title="Open on YouTube"><svg><use href="#i-youtube" /></svg><span>YouTube</span></a>
      <a id="yourss-modal-link-tab" class="yourss-btn" data-action="close-dialog" target="_blank" rel="noopener" title="Player in a new tab"><svg><use href="#i-fullscreen" /></svg></a>
    </div>
  </div>
</dialog>
