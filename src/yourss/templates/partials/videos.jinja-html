{% from "partials/macros.jinja-html" import avatar %}
{% for video in videos %}
<div id="yourss-video-{{ video.video_id }}" class="yourss-video" data-video-id="{{ video.video_id }}"{% if video.channel %} data-channel-id="{{ video.channel.channel_id }}"{% endif %}
  {% if loop.last and next_page_url %} hx-get="{{ next_page_url }}" hx-trigger="revealed" hx-swap="afterend"{% endif %}>
  <div class="yourss-playing-bar">
    <span>{{ video.title|clean_title }}</span>
    <button type="button" class="yourss-icon-btn is-small yourss-close-player" data-action="close-player" title="Close the player (Esc)"><svg><use href="#i-close" /></svg></button>
  </div>
  <div class="yourss-media" data-action="play">
    <img referrerpolicy="no-referrer" class="yourss-thumbnail" src="{{ video.thumbnail }}" alt="" loading="lazy" />
    <div class="yourss-player-container"></div>
    <span class="yourss-play-badge"><svg><use href="#i-play" /></svg></span>
    <span class="yourss-new" data-watched-feature title="Not watched yet">New</span>
    <div class="yourss-dock-bar">
      <span class="yourss-dock-title">{{ video.title|clean_title }}</span>
      <button type="button" class="yourss-icon-btn" data-action="undock" title="Back to the video"><svg><use href="#i-return" /></svg></button>
      <button type="button" class="yourss-icon-btn yourss-dock-close" data-action="close-player" title="Stop"><svg><use href="#i-close" /></svg></button>
    </div>
  </div>
  <div class="yourss-dock-placeholder" data-action="undock"><svg><use href="#i-play" /></svg><span>Playing in the mini player, click to come back</span></div>
  <div class="yourss-video-body">
    {% if video.channel %}
    <a class="yourss-video-channel" href="{{ page_path }}?c={{ video.channel.channel_id }}" hx-get="/htmx/channel/{{ video.channel.channel_id }}"
      hx-target="#yourss-content" hx-push-url="{{ page_path }}?c={{ video.channel.channel_id }}">
      {{ avatar(video.channel, 22) }}<span>{{ video.channel.name }}</span>
    </a>
    {% endif %}
    <p class="yourss-video-title">{{ video.title|clean_title }}</p>
    <div class="yourss-video-meta">
      {% if video.published_at %}
      <time datetime="{{ video.published_at.isoformat() }}" title="{{ video.published_at }}">{{ video.published_at|date_humanize }}</time>
      {% else %}
      <span>{{ video.published_text or video.views_text or "" }}</span>
      {% endif %}
      <span class="yourss-spacer"></span>
      <button type="button" class="yourss-icon-btn is-small" data-watched-feature data-action="toggle-watched" title="Toggle watched"><svg><use href="#i-check" /></svg></button>
      <button type="button" class="yourss-icon-btn is-small" data-action="modal" title="Open in modal"><svg><use href="#i-external" /></svg></button>
    </div>
  </div>
</div>
{% endfor %}
