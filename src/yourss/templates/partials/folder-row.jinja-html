{# A folder of the sidebar; on /me, yourss-me.js fills an empty copy of it from a <template> #}
    <details class="yourss-folder" name="yourss-folder" data-folder="{{ folder_name }}"{% if current %} open{% endif %}>
      <summary class="yourss-nav-item" title="The latest videos of {{ folder_name }}" hx-get="{{ address }}" hx-target="#yourss-content" hx-swap="innerHTML show:window:top" hx-sync="#yourss-content:replace"
        hx-push-url="{{ address }}" hx-trigger="click[!event.target.closest('.yourss-caret, [data-action]')]">
        <button type="button" class="yourss-caret" title="Fold / unfold" aria-label="Fold / unfold"><svg><use href="#i-chevron" /></svg></button>
        <svg class="yourss-folder-icon is-closed"><use href="#i-folder" /></svg><svg class="yourss-folder-icon is-open"><use href="#i-folder-open" /></svg>
        <span class="yourss-label">{{ folder_name }}</span>
        <span class="yourss-badge yourss-count" data-watched-feature data-folder-count="{{ folder_name }}" hidden></span>
        {% if me_page %}
        <button type="button" class="yourss-icon-btn is-small yourss-row-btn yourss-me-row-btn" data-action="add-channel" title="Add a channel or a playlist to this folder (a)" aria-label="Add a channel or a playlist"><svg><use href="#i-plus" /></svg></button>
        <button type="button" class="yourss-icon-btn is-small yourss-row-btn yourss-me-row-btn" data-action="me-remove-folder" title="Remove this folder" aria-label="Remove this folder"><svg><use href="#i-close" /></svg></button>
        {% endif %}
        <button type="button" class="yourss-icon-btn is-small yourss-row-btn" data-watched-feature data-action="mark-feed-watched" title="Mark every video of this folder as watched"><svg><use href="#i-check-all" /></svg></button>
      </summary>
      <ul id="yourss-folder-list-{{ folder_name }}" class="yourss-channels" data-folder-list="{{ folder_name }}">
        {% if current %}
        {% include "partials/entries.jinja-html" %}
        {% endif %}
      </ul>
    </details>
