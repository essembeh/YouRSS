{# The chrome of the embedded player, cloned into the playing card by yourss-player.js and removed when it closes #}
<div class="yourss-playing-bar">
  <span data-player-title></span>
  <button type="button" class="yourss-icon-btn is-small yourss-close-player" data-action="close-player" title="Close the player (Esc)"><svg><use href="#i-close" /></svg></button>
</div>
<div class="yourss-player-container is-active"></div>
<div class="yourss-dock-bar">
  <span class="yourss-dock-title" data-player-title></span>
  <button type="button" class="yourss-icon-btn" data-action="undock" title="Back to the video"><svg><use href="#i-return" /></svg></button>
  <button type="button" class="yourss-icon-btn yourss-dock-close" data-action="close-player" title="Stop"><svg><use href="#i-close" /></svg></button>
</div>
<div class="yourss-dock-placeholder" data-action="undock"><svg><use href="#i-play" /></svg><span>Playing in the mini player, click to come back</span></div>
