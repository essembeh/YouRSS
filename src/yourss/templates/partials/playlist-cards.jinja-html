{# The playlists of the Playlists tab of a channel (`owner`): a card opens the playlist in the page, under its channel #}
{% for playlist in playlists %}
{# Under its channel, the address names both: <page>?c=<channel>&p=<playlist> #}
{% set address = link_prefix ~ ("c=" ~ owner ~ "&" if owner else "") ~ "p=" ~ playlist.playlist_id %}
<div class="yourss-card" data-playlist-id="{{ playlist.playlist_id }}"
  {% if loop.last and next_page_url %} hx-get="{{ next_page_url }}" hx-trigger="revealed" hx-swap="afterend transition:false"{% endif %}>
  <a class="yourss-media" href="{{ address }}" hx-get="/htmx/playlist/{{ playlist.playlist_id }}?tab=all{% if owner %}&channel={{ owner }}{% endif %}" hx-target="#yourss-content"
    hx-sync="#yourss-content:replace" hx-push-url="{{ address }}" title="Every video of {{ playlist.title }}">
    <img referrerpolicy="no-referrer" class="yourss-thumbnail" src="{{ playlist.thumbnail }}" alt="" loading="lazy" />
    {% if playlist.count_text %}<span class="yourss-card-count"><svg><use href="#i-list" /></svg>{{ playlist.count_text }}</span>{% endif %}
  </a>
  <div class="yourss-video-body">
    <p class="yourss-video-title">{{ playlist.title|clean_title }}</p>
    <div class="yourss-video-meta">
      <span class="yourss-spacer"></span>
      <a class="yourss-icon-btn is-small" href="https://www.youtube.com/playlist?list={{ playlist.playlist_id }}" target="_blank" rel="noopener" title="Open on Youtube" aria-label="Open on Youtube"><svg><use href="#i-external" /></svg></a>
    </div>
  </div>
</div>
{% endfor %}
