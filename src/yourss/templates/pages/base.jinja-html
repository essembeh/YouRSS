<!DOCTYPE html>
<html lang="en" data-theme="neon">

<head>
  <title>YouRSS{{ title_sep|default(" - ") }}{{ title }}</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark light" />
  {# Every htmx swap runs inside a view transition (the CSS animates it where the browser supports them) #}
  <meta name="htmx-config" content='{"globalViewTransitions": true}' />
  <script>
    // Neon is the default theme; a theme chosen in this browser is applied before first paint.
    try {
      const theme = localStorage.getItem("yourss-theme")
      if (["light", "dark", "neon"].includes(theme)) {
        document.documentElement.dataset.theme = theme
      }
    } catch (e) {}
  </script>
  <link href="{{ static_url('yourss.css') }}" rel="stylesheet" />
  <link rel="icon" type="image/png" sizes="32x32" href="{{ static_url('icons/favicon-32.png') }}" />
  <link rel="icon" type="image/png" sizes="192x192" href="{{ static_url('icons/icon-192.png') }}" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="{{ static_url('manifest.json') }}" />
  <meta name="apple-mobile-web-app-title" content="YouRSS" />
  <meta name="application-name" content="YouRSS" />
  <meta name="theme-color" content="#0a0718" />
</head>

<body class="no-watched" hx-indicator="#yourss-loading"{% if page_names is defined %} data-page-names="{{ page_names|join(',') }}" data-page-max="{{ max_page_items }}"{% endif %}>
  {% include "partials/icons.jinja-html" %}
  <div id="yourss-loading" class="yourss-loading" aria-hidden="true"></div>

  <div class="yourss-app">
    <header class="yourss-topbar">
      <button type="button" class="yourss-icon-btn" data-action="menu" aria-label="Menu"><svg><use href="#i-menu" /></svg></button>
      <a class="yourss-brand" href="{{ home_path|default(request.url.path) }}"><img src="{{ static_url('icons/icon-192.png') }}" width="24" height="24" alt="" /><span>You<em>RSS</em></span></a>
      {% if folders is defined %}
      {# Phones: the open folder and its neighbours, the same move as a swipe on the content #}
      <nav class="yourss-folder-nav" aria-label="Folders">
        <button type="button" class="yourss-icon-btn" data-action="folder-step" data-step="-1" aria-label="Previous folder"><svg class="is-flipped"><use href="#i-chevron" /></svg></button>
        <button type="button" class="yourss-folder-name" id="yourss-folder-name" data-action="menu" title="Choose a folder"></button>
        <button type="button" class="yourss-icon-btn" data-action="folder-step" data-step="1" aria-label="Next folder"><svg><use href="#i-chevron" /></svg></button>
      </nav>
      {% endif %}
      <span class="yourss-spacer"></span>
      <div class="yourss-segment yourss-filter" data-watched-feature role="group" aria-label="Videos shown">
        <button type="button" data-action="set-flag" data-flag="hide-watched" data-value="0" title="Show every video (h)">All</button>
        <button type="button" data-action="set-flag" data-flag="hide-watched" data-value="1" title="Only show the videos not watched yet (h)">New</button>
      </div>
      {% if videos is defined or folders is defined %}
      <button type="button" class="yourss-icon-btn yourss-listen-btn" data-action="listen" title="Listen: play the page as music (l)" aria-label="Listen"><svg><use href="#i-headphones" /></svg></button>
      {% endif %}
      <button type="button" class="yourss-icon-btn yourss-settings-btn" data-action="settings" aria-label="Settings"><svg><use href="#i-settings" /></svg></button>
    </header>

    {% include "partials/sidebar.jinja-html" %}
    <div class="yourss-backdrop" data-action="menu"></div>

    <main class="yourss-main">
      {% block content %}{% endblock %}
    </main>
  </div>

  {% include "partials/settings.jinja-html" %}
  {% include "partials/shortcuts.jinja-html" %}
  {% if page_names is defined %}{% include "partials/add.jinja-html" %}{% include "partials/welcome.jinja-html" %}{% endif %}
  <template id="yourss-empty-template">{% include "partials/empty.jinja-html" %}</template>
  <template id="yourss-failed-template">{% include "partials/failed.jinja-html" %}</template>
  <template id="yourss-player-template">{% include "partials/player.jinja-html" %}</template>
  <template id="yourss-stage-template">{% include "partials/stage.jinja-html" %}</template>
  <button id="scroll-to-top" type="button" data-action="scroll-top" title="Back to top"><svg><use href="#i-up" /></svg></button>

  <script src="https://unpkg.com/htmx.org@2.0.11" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
  <script type="importmap">
    {"imports": {"yourss/core": "{{ static_url('yourss-core.js') }}", "yourss/watched": "{{ static_url('yourss-watched.js') }}", "yourss/player": "{{ static_url('yourss-player.js') }}", "yourss/listen": "{{ static_url('yourss-listen.js') }}"}}
  </script>
  <script type="module" src="{{ static_url('yourss.js') }}"></script>
</body>

</html>
