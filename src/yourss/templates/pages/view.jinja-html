{% extends "pages/base.jinja-html" %}
{% block content %}
<div id="yourss-fetch-status">{% include "partials/fetch-status.jinja-html" %}</div>
{% if page_names is defined %}
<div id="yourss-bookmark" class="yourss-notice" role="status" hidden>
  <svg><use href="#i-bookmark" /></svg>
  <span><strong>Bookmark this page.</strong> Its address holds your channels: nothing is stored on the server.</span>
  <button type="button" class="yourss-btn" data-action="copy-link">Copy the address</button>
  <button type="button" class="yourss-icon-btn is-small" data-action="dismiss" aria-label="Dismiss"><svg><use href="#i-close" /></svg></button>
</div>
{% endif %}
<div id="yourss-content" hx-history-elt>
  {% if folder is defined %}
  <div data-folder-page="{{ folder.name }}">{% include "partials/videos-container.jinja-html" %}</div>
  {% elif me_page %}
  <div class="yourss-empty" data-me-shell>
    <strong id="yourss-me-empty">Create your first folder</strong>
    <strong id="yourss-me-choose" hidden>Choose a folder</strong>
    <span>Your folders stay in this browser, and can be copied to your other devices.</span>
    <div id="yourss-me-start" class="yourss-me-start">
      <button type="button" class="yourss-btn" data-action="me-new-folder"><svg><use href="#i-plus" /></svg><span>New folder</span></button>
      <button type="button" class="yourss-btn" data-action="me-import"><svg><use href="#i-folder-open" /></svg><span>Import a file</span></button>
    </div>
  </div>
  {% elif folders is defined %}
  <div class="yourss-empty">
    <strong>Choose a folder</strong>
    <span>Open a folder of the sidebar to read the latest videos of its channels.</span>
  </div>
  {% else %}
  {% include "partials/videos-container.jinja-html" %}
  {% endif %}
</div>
{% endblock %}
