# Set logger level
LOGURU_LEVEL=DEBUG

# You can declare user pages in a dedicated file
YOURSS_USERS_FILE=samples/users.yaml

# Set to false to forbid visitors from building their own multi channel page
# YOURSS_CUSTOM_PAGES_ENABLED=true

# How many channels and playlists a custom page may hold, 12 by default
# YOURSS_MAX_PAGE_ITEMS=12

# Serve the generated API documentation (/docs, /redoc), off by default
YOURSS_API_DOCS_ENABLED=true

# To clean titles and prevent UPPERCASE
YOURSS_CLEAN_TITLES=true

# RSS cache on disk, off by default. Without YOURSS_CACHE_FOLDER a temporary folder is used
YOURSS_CACHE_ENABLED=true
# YOURSS_CACHE_FOLDER=/tmp/yourss-cache
# A cached feed younger than this is served without asking Youtube, default 30 minutes
# YOURSS_CACHE_TTL=PT30M
# When the fetch fails, a cached feed younger than this is served instead, default 48h
# YOURSS_CACHE_FALLBACK_TTL=PT48H
